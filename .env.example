# Copy to .env.local (on your computer) or add in Hostinger's environment settings.
# Never commit the real values.

# Brevo → SMTP & API → API keys → Generate a new API key
BREVO_API_KEY=

# Where form messages are emailed (Contact, Start Project, Get Started, Free Design, Careers)
FORMS_TO_EMAIL=hello@websylime.com

# Sender shown on those emails. Must be a sender/domain verified in Brevo.
FORMS_FROM_EMAIL=hello@websylime.com

# Brevo → Contacts → Lists: the number (id) of each list
BREVO_NEWSLETTER_LIST=
BREVO_WAITLIST_LIST=
