# Copy to .env.local (on your computer) or add in Hostinger's environment settings.
# Never commit the real values.

# Brevo → SMTP & API → API keys → Generate a new API key
BREVO_API_KEY=

# Where form messages are emailed (Contact, Start Project, Get Started, Free Design, Careers)
FORMS_TO_EMAIL=hello@websylime.com

# Sender shown on those emails. Must be a sender/domain verified in Brevo.
FORMS_FROM_EMAIL=hello@websylime.com

# Brevo → Contacts → Lists: the number (id) of each list
BREVO_NEWSLETTER_LIST=
# Brevo template id of the newsletter confirm (double opt-in) email. Empty = no confirm step
BREVO_DOI_TEMPLATE=
BREVO_WAITLIST_LIST=
# Backup of every lead (needs the LEAD_FORM, LEAD_PLAN, LEAD_PHONE, LEAD_BUSINESS, LEAD_MESSAGE contact attributes)
BREVO_LEADS_LIST=
# Get Started leads join this list; a Brevo automation sends the follow-up emails
BREVO_FOLLOWUP_LIST=
# People who booked a call or are talking to us (the follow-up emails skip them)
BREVO_BOOKED_LIST=

# Cal.com → Settings → Developer → Webhooks → URL https://www.websylime.com/api/cal,
# event "Booking created". Type the same secret here.
CAL_WEBHOOK_SECRET=
